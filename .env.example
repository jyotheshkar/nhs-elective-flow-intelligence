# -----------------------------------------------------------------------------
# NHS Elective Flow Intelligence - environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value below has a working default, so the
# application runs with no .env file at all.
#
# NEVER commit a completed .env - it is git-ignored for this reason.
# -----------------------------------------------------------------------------

# --- Data mode ---------------------------------------------------------------
# official : ingested NHS England public statistics (default)
# demo     : clearly-labelled synthetic data, shown with a persistent banner
APP_DATA_MODE=official

# Number of most recent reporting months to ingest (1-36).
INGEST_MONTHS=18

# --- Analytics tunables ------------------------------------------------------
# Services with a waiting list below this are scored but excluded from
# headline rankings, because small lists produce unstable percentage growth.
MIN_WAITING_LIST_FOR_RANKING=200

# Minimum monthly observations before a forecast is attempted.
MIN_HISTORY_FOR_FORECAST=6

# The 18-week operational benchmark used for the performance-gap component.
REFERRAL_TO_TREATMENT_BENCHMARK=92.0

# --- API ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# --- Optional LLM executive briefing ----------------------------------------
# Entirely optional. The product is fully functional without it: the default
# briefing is generated deterministically from computed values.
# When enabled, only aggregate metrics are sent - never any raw data - and the
# output is clearly labelled as AI-generated in the interface.
LLM_BRIEFING_ENABLED=false
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Frontend ----------------------------------------------------------------
# Where the browser should reach the API. Change this when deploying.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
