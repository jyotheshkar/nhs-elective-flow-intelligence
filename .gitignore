# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Next.js ---
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.eslintcache

# --- Environment & secrets ---
# .env may contain an API key for the optional LLM briefing. Never commit it.
.env
.env.local
.env.*.local
!.env.example

# --- Data ---
# Source workbooks are large (~350 MB) and reproducibly re-downloadable from
# NHS England, so they are never committed.
data/raw/*
!data/raw/.gitkeep

# The PROCESSED analytical layer (Parquet, ~35 MB total) IS committed: it is
# the deployable artefact. Free hosting has an ephemeral filesystem, so the
# backend build step materialises DuckDB from these files at deploy time
# (scripts/materialise_warehouse.py). The DuckDB file itself is not committed
# because its storage format is version-sensitive; Parquet is the durable
# interchange layer.
data/processed/*
!data/processed/.gitkeep
!data/processed/*.parquet

# The generated demo dataset is small and useful for a zero-network demo.
!data/sample/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
