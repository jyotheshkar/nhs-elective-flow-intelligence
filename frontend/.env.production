# Production API base URL, inlined into the client bundle at build time.
#
# NEXT_PUBLIC_* values are public by definition - this is a URL, not a secret,
# so committing it is safe and means Vercel builds need no manual env setup.
# `next dev` ignores this file and falls back to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=https://nhs-elective-flow-api.onrender.com
