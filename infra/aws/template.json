{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NHS Elective Flow public-aggregate portfolio: scheduled candidates and manually pinned read-only API. No patient data.",
  "Parameters": {
    "ImageTag": {
      "Type": "String",
      "Default": "initial",
      "AllowedPattern": "[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}"
    },
    "DeployApi": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "ReleaseId": {
      "Type": "String",
      "Default": "not-yet-published",
      "AllowedPattern": "[A-Za-z0-9][A-Za-z0-9_-]{0,79}"
    },
    "MinimumReportingMonth": {
      "Type": "String",
      "Default": "2026-06",
      "AllowedPattern": "[0-9]{4}-(0[1-9]|1[0-2])"
    },
    "FrontendOrigin": {
      "Type": "String",
      "Default": "https://nhs-elective-flow-intelligence.vercel.app",
      "AllowedPattern": "https://[^/ ]+"
    },
    "ScheduleState": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "ENABLED",
        "DISABLED"
      ]
    },
    "AlertEmail": {
      "Type": "String",
      "AllowedPattern": "[^@ ]+@[^@ ]+\\.[^@ ]+"
    }
  },
  "Conditions": {
    "CreateApi": {
      "Fn::Equals": [
        {
          "Ref": "DeployApi"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "BoundHistoricalVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 90
              }
            },
            {
              "Id": "RawRetention",
              "Status": "Enabled",
              "Prefix": "raw/",
              "ExpirationInDays": 180
            }
          ]
        }
      }
    },
    "DataBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Images": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "BatchLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      }
    },
    "FailureTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [
          {
            "Protocol": "email",
            "Endpoint": {
              "Ref": "AlertEmail"
            }
          }
        ]
      }
    },
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.83.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway"
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.83.1.0/24",
        "MapPublicIpOnLaunch": true
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "SubnetRoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "BatchSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "No inbound access; HTTPS to published NHS sources and AWS APIs",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "disabled"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WorkloadAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Images",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BatchLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WorkloadAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/releases/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/raw/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${DataBucket.Arn}/releases/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BatchTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "1024",
        "Memory": "4096",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "BuildRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "refresh",
            "Image": {
              "Fn::Sub": "${Images.RepositoryUri}:${ImageTag}"
            },
            "Essential": true,
            "Command": [
              "python",
              "infra/aws/runtime.py",
              "build"
            ],
            "Environment": [
              {
                "Name": "RELEASE_BUCKET",
                "Value": {
                  "Ref": "DataBucket"
                }
              },
              {
                "Name": "BASELINE_RELEASE_ID",
                "Value": {
                  "Ref": "ReleaseId"
                }
              },
              {
                "Name": "MIN_REPORTING_MONTH",
                "Value": {
                  "Ref": "MinimumReportingMonth"
                }
              },
              {
                "Name": "APP_DATA_MODE",
                "Value": "official"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "BatchLogs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "refresh"
              }
            },
            "StopTimeout": 120
          }
        ]
      }
    },
    "ScheduleRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WorkloadAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecs:RunTask",
                  "Resource": {
                    "Ref": "BatchTask"
                  },
                  "Condition": {
                    "ArnEquals": {
                      "ecs:cluster": {
                        "Fn::GetAtt": [
                          "Cluster",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ExecutionRole",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "BuildRole",
                        "Arn"
                      ]
                    }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "ecs-tasks.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "RefreshSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "DependsOn": "InternetRoute",
      "Properties": {
        "Description": "Weekly check for new monthly public RTT publications; produces candidates only",
        "ScheduleExpression": "cron(0 8 ? * MON *)",
        "ScheduleExpressionTimezone": "Europe/London",
        "State": {
          "Ref": "ScheduleState"
        },
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Cluster",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "ScheduleRole",
              "Arn"
            ]
          },
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 3600,
            "MaximumRetryAttempts": 0
          },
          "EcsParameters": {
            "TaskDefinitionArn": {
              "Ref": "BatchTask"
            },
            "TaskCount": 1,
            "LaunchType": "FARGATE",
            "PlatformVersion": "LATEST",
            "NetworkConfiguration": {
              "AwsvpcConfiguration": {
                "AssignPublicIp": "ENABLED",
                "Subnets": [
                  {
                    "Ref": "Subnet"
                  }
                ],
                "SecurityGroups": [
                  {
                    "Ref": "BatchSecurityGroup"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "FailedTaskRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Notify on any batch task stop; inspect stoppedReason and container exitCode, including OOM",
        "EventPattern": {
          "source": [
            "aws.ecs"
          ],
          "detail-type": [
            "ECS Task State Change"
          ],
          "detail": {
            "clusterArn": [
              {
                "Fn::GetAtt": [
                  "Cluster",
                  "Arn"
                ]
              }
            ],
            "lastStatus": [
              "STOPPED"
            ]
          }
        },
        "Targets": [
          {
            "Arn": {
              "Ref": "FailureTopic"
            },
            "Id": "BatchTaskStopped"
          }
        ]
      }
    },
    "TopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "FailureTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "FailureTopic"
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "FailedTaskRule",
                      "Arn"
                    ]
                  }
                }
              },
              "Principal": {
                "Service": "events.amazonaws.com"
              }
            }
          ]
        }
      }
    },
    "RefreshFailures": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "BatchLogs"
        },
        "FilterPattern": "{ $.event = \"refresh_failed\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": "NhsElectiveFlow",
            "MetricName": {
              "Fn::Sub": "${AWS::StackName}-RefreshFailures"
            },
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "RefreshFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Refresh failed. Candidate not promoted; serving release remains pinned.",
        "Namespace": "NhsElectiveFlow",
        "MetricName": {
          "Fn::Sub": "${AWS::StackName}-RefreshFailures"
        },
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "FailureTopic"
          }
        ]
      }
    },
    "ScheduleFailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Scheduler target could not be invoked; inspect IAM/task/network config",
        "Namespace": "AWS/Scheduler",
        "MetricName": "TargetErrorCount",
        "Dimensions": [
          {
            "Name": "ScheduleGroup",
            "Value": "default"
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "FailureTopic"
          }
        ]
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "tasks.apprunner.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WorkloadAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${DataBucket.Arn}/releases/${ReleaseId}/*"
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "CreateApi"
    },
    "ApiEcrRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "build.apprunner.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WorkloadAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Images",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "CreateApi"
    },
    "ApiScaling": {
      "Type": "AWS::AppRunner::AutoScalingConfiguration",
      "Condition": "CreateApi",
      "Properties": {
        "MinSize": 1,
        "MaxSize": 1,
        "MaxConcurrency": 50
      }
    },
    "Api": {
      "Type": "AWS::AppRunner::Service",
      "Condition": "CreateApi",
      "Properties": {
        "AutoScalingConfigurationArn": {
          "Fn::GetAtt": [
            "ApiScaling",
            "AutoScalingConfigurationArn"
          ]
        },
        "SourceConfiguration": {
          "AutoDeploymentsEnabled": false,
          "AuthenticationConfiguration": {
            "AccessRoleArn": {
              "Fn::GetAtt": [
                "ApiEcrRole",
                "Arn"
              ]
            }
          },
          "ImageRepository": {
            "ImageIdentifier": {
              "Fn::Sub": "${Images.RepositoryUri}:${ImageTag}"
            },
            "ImageRepositoryType": "ECR",
            "ImageConfiguration": {
              "Port": "8000",
              "StartCommand": "python infra/aws/runtime.py serve",
              "RuntimeEnvironmentVariables": [
                {
                  "Name": "RELEASE_BUCKET",
                  "Value": {
                    "Ref": "DataBucket"
                  }
                },
                {
                  "Name": "RELEASE_ID",
                  "Value": {
                    "Ref": "ReleaseId"
                  }
                },
                {
                  "Name": "CORS_ORIGINS",
                  "Value": {
                    "Ref": "FrontendOrigin"
                  }
                },
                {
                  "Name": "APP_DATA_MODE",
                  "Value": "official"
                }
              ]
            }
          }
        },
        "InstanceConfiguration": {
          "Cpu": "1 vCPU",
          "Memory": "2 GB",
          "InstanceRoleArn": {
            "Fn::GetAtt": [
              "ApiRole",
              "Arn"
            ]
          }
        },
        "HealthCheckConfiguration": {
          "Protocol": "HTTP",
          "Path": "/health",
          "Interval": 10,
          "Timeout": 5,
          "HealthyThreshold": 2,
          "UnhealthyThreshold": 5
        }
      }
    }
  },
  "Outputs": {
    "ReleaseBucket": {
      "Value": {
        "Ref": "DataBucket"
      }
    },
    "ImageRepository": {
      "Value": {
        "Fn::GetAtt": [
          "Images",
          "RepositoryUri"
        ]
      }
    },
    "ClusterArn": {
      "Value": {
        "Fn::GetAtt": [
          "Cluster",
          "Arn"
        ]
      }
    },
    "TaskDefinition": {
      "Value": {
        "Ref": "BatchTask"
      }
    },
    "SubnetId": {
      "Value": {
        "Ref": "Subnet"
      }
    },
    "SecurityGroupId": {
      "Value": {
        "Ref": "BatchSecurityGroup"
      }
    },
    "TaskLogs": {
      "Value": {
        "Ref": "BatchLogs"
      }
    },
    "ApiUrl": {
      "Condition": "CreateApi",
      "Value": {
        "Fn::Sub": "https://${Api.ServiceUrl}"
      }
    },
    "ApiArn": {
      "Condition": "CreateApi",
      "Value": {
        "Fn::GetAtt": [
          "Api",
          "ServiceArn"
        ]
      }
    }
  }
}
