            "exec": [
              "pm.test('Unknown service 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "R14 CSV: provenance accompanies export",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/rankings/export?limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CSV response',()=>{pm.response.to.have.status(200);pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv')});",
              "pm.test('Source label and field header',()=>{pm.expect(pm.response.text()).to.include('# Data source type:');pm.expect(pm.response.text()).to.include(pm.environment.get('expected_source'));pm.expect(pm.response.text()).to.include('provider_code')});"
            ]
          }
        }
      ]
    },
    {
      "name": "R15 Readiness still intact after invalid inputs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Rejected inputs have not broken warehouse',()=>pm.expect(b.warehouse_available).to.eql(true));"
            ]
          }
        }
      ]
    }
  ]
}
