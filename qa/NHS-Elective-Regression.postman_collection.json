            ]
          }
        }
      ]
    },
    {
      "name": "R10 Validation: unknown input field",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"provider_code\": \"{{provider_code}}\", \"specialty_code\": \"{{specialty_code}}\", \"uplift_pct\": 10, \"invented_field\": \"unexpected\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
