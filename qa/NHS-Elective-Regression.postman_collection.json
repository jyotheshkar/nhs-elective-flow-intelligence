{
  "info": {
    "name": "NHS Elective Flow - Risk Based API Regression",
    "description": "Portfolio test assets. Execute against local built warehouse first. No results are implied by this file. POST scenario computes projections without persisting changes. Never targets patient-level systems. Source mode must be set explicitly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "R01 Health: ready warehouse",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Warehouse ready',()=>pm.expect(b.warehouse_available).to.eql(true));",
              "pm.test('Status ok',()=>pm.expect(b.status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "R02 Metadata: source mode explicit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/metadata"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Expected data source',()=>pm.expect(b.provenance.data_source_type).to.eql(pm.environment.get('expected_source')));",
              "pm.test('Demo flag agrees',()=>pm.expect(b.provenance.is_demo).to.eql(b.provenance.data_source_type==='DEMO_SYNTHETIC'));",
              "pm.test('Reported coverage nonempty',()=>{pm.expect(b.fact_rows).to.be.above(0);pm.expect(b.provenance.reporting_months).to.be.above(0)});"
            ]
          }
        }
      ]
    },
    {
      "name": "R03 Rankings: ordered bounded discover test service",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/rankings?limit=25"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Pagination contract',()=>{pm.expect(b.returned).to.eql(b.rows.length);pm.expect(b.returned).to.be.at.most(25);pm.expect(b.total).to.be.at.least(b.returned)});",
              "pm.test('Scores bounded and descending',()=>{const s=b.rows.map(x=>x.priority_score);s.forEach(x=>{pm.expect(x).to.be.at.least(0);pm.expect(x).to.be.at.most(100)});for(let i=1;i<s.length;i++)pm.expect(s[i]).to.be.at.most(s[i-1]);});",
              "const target=b.rows.find(x=>x.forecast_status==='ok' && x.rolling_activity_3m>0);",
              "pm.test('Forecastable service available for scenario tests',()=>pm.expect(target).to.be.an('object'));",
              "if(target){pm.environment.set('provider_code',target.provider_code);pm.environment.set('specialty_code',target.specialty_code);}"
            ]
          }
        }
      ]
    },
    {
      "name": "R04 Service: decomposable score and deterministic briefing",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/service/{{provider_code}}/{{specialty_code}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Score contributions reconcile',()=>{const total=b.score_components.reduce((a,x)=>a+(x.contribution||0),0);pm.expect(Math.abs(total-b.service.priority_score)).to.be.below(0.21)});",
              "pm.test('Briefing generated by rules',()=>pm.expect(b.briefing.generated_by).to.eql('deterministic_rules'));",
              "pm.test('Caveats retained',()=>pm.expect(b.briefing.caveats.length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "R05 Forecast: interval ordering and limitations",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/forecast?provider_code={{provider_code}}&specialty_code={{specialty_code}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Selected service forecast ok',()=>pm.expect(b.status).to.eql('ok'));",
              "pm.test('Horizons 1 3 6',()=>pm.expect(b.points.map(x=>x.horizon_months)).to.eql([1,3,6]));",
              "pm.test('Bands contain estimate',()=>b.points.forEach(x=>{pm.expect(x.lower).to.be.at.most(x.value);pm.expect(x.upper).to.be.at.least(x.value)}));",
              "pm.test('Indicative interval label',()=>pm.expect(b.method_note.toLowerCase()).to.include('indicative'));"
            ]
          }
        }
      ]
    },
    {
      "name": "R06 Scenario: zero uplift equals baseline",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"provider_code\": \"{{provider_code}}\", \"specialty_code\": \"{{specialty_code}}\", \"uplift_pct\": 0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Scenario available',()=>pm.expect(b.status).to.eql('ok'));",
              "pm.test('Zero uplift invariant',()=>{const s=b.series.find(x=>x.uplift_pct===0);pm.expect(s).to.be.an('object');s.points.forEach(p=>pm.expect(p.scenario_backlog).to.eql(p.baseline_backlog))});",
              "pm.test('Assumptions and noncausal caveat',()=>{pm.expect(b.assumptions.length).to.be.at.least(5);pm.expect(b.disclaimer.toLowerCase()).to.include('not a causal prediction')});"
            ]
          }
        }
      ]
    },
    {
      "name": "R07 Scenario: monotonic nonnegative projected backlog",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"provider_code\": \"{{provider_code}}\", \"specialty_code\": \"{{specialty_code}}\", \"uplift_pct\": 10}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const b=pm.response.json();",
              "pm.test('Scenario available',()=>pm.expect(b.status).to.eql('ok'));",
              "pm.test('Activity uplift cannot increase backlog',()=>{const series=[...b.series].sort((a,c)=>a.uplift_pct-c.uplift_pct);pm.expect(series.length).to.be.above(1);for(let i=0;i<series.length;i++){series[i].points.forEach(p=>{pm.expect(p.scenario_backlog).to.be.at.least(0);if(i){const prior=series[i-1].points.find(x=>x.horizon_months===p.horizon_months);pm.expect(p.scenario_backlog).to.be.at.most(prior.scenario_backlog)}})}});"
            ]
          }
        }
      ]
    },
    {
      "name": "R08 Validation: negative activity uplift",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/scenario",
        "body": {
          "mode": "raw",
          "raw": "{\"provider_code\": \"{{provider_code}}\", \"specialty_code\": \"{{specialty_code}}\", \"uplift_pct\": -1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reject negative uplift',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
