              "pm.test('Reject unknown field',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "R11 Validation: sort injection string",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/rankings?sort_by=%3B%20DROP%20TABLE%20fact_rtt"
      },
      "event": [
        {
          "listen": "test",
